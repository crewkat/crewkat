{
  "name": "hatch-ts-space-tradesign",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "build": "bun run build:server && bun run build:privileged && bun run build:client",
    "build:server": "cd server && bun build ./src/actions.ts --target=bun --outfile=./dist/actions.js",
    "build:client": "bun ./client/build.mjs",
    "build:privileged": "cd server && bun build ./src/privileged.ts --target=bun --outfile=./dist/privileged.js"
  },
  "dependencies": {
    "@hatch/space-sdk": "file:../vendor/space-sdk.tgz",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "jspdf": "3.0.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  }
}
